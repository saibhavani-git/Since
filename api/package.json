{
  "name": "since-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Since API — auth, watchlists, market data and the digest engine, exposed over a versioned REST API.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx watch --clear-screen=false --env-file-if-exists=.env src/worker.ts",
    "infra:up": "docker compose -f ../docker-compose.yml up -d --wait postgres redis",
    "infra:down": "docker compose -f ../docker-compose.yml down",
    "infra:reset": "docker compose -f ../docker-compose.yml down -v && docker compose -f ../docker-compose.yml up -d --wait postgres redis",
    "db:psql": "docker compose -f ../docker-compose.yml exec postgres psql -U since -d since",
    "redis:cli": "docker compose -f ../docker-compose.yml exec redis redis-cli",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@node-rs/argon2": "^2.2.0",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.11",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "yahoo-finance2": "^4.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
