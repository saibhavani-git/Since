# Copy to .env. Every value has a safe development default except DATABASE_URL,
# which points at the Docker Postgres started by `pnpm infra:up`.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres + Redis. `pnpm infra:up` starts both (../docker-compose.yml).
# Leave DATABASE_URL empty only to fall back to embedded PGlite (what the test suite uses).
# Leave REDIS_URL empty to use an in‑process cache (single instance, no worker).
DATABASE_URL=postgres://since:since@localhost:5432/since
REDIS_URL=redis://localhost:6379

# Browser origins allowed to call the API with cookies (comma‑separated).
CORS_ORIGINS=http://localhost:3001

# Required in production, >= 32 chars.
# JWT_SECRET=

# dev_fixed → OTP is always OTP_DEV_CODE and is echoed in the signup response.
# console   → a random OTP is logged.
# msg91     → real SMS; needs MSG91_AUTH_KEY and MSG91_TEMPLATE_ID.
OTP_SENDER=dev_fixed
OTP_DEV_CODE=246810

# yahoo → real delayed NSE data. fixture → deterministic, offline.
MARKET_DATA_PROVIDER=yahoo

# Evidence for "why". Free and keyless.
#   live    → BSE corporate announcements + Google News RSS (each toggleable below).
#   fixture → deterministic, offline.  none → no evidence.
NEWS_PROVIDER=live
FILINGS_BSE=true
NEWS_GOOGLE=true
# How long a stock's evidence and written story are shared before refreshing.
EVIDENCE_CACHE_TTL_SECONDS=1800
STORY_CACHE_TTL_SECONDS=3600

# Voice for the narrated catch‑up. none → silent. cartesia needs a voice id; sarvam a speaker name.
SPEECH_PROVIDER=none
# SPEECH_API_KEY=            (or CARTESIA_API_KEY / SARVAM_API_KEY)
# SPEECH_VOICE_ID=           (Cartesia default: Harsh — Approachable Analyst)
# SPEECH_MODEL=sonic-3.6

# Language model that writes the card's "why" and the in‑depth report from
# our facts + evidence (templates are the default and always work).
#   openai    → AI_MODEL e.g. gpt-6-astra (default). Key: AI_API_KEY or OPENAI_API_KEY
#   anthropic → AI_MODEL e.g. claude-sonnet-4-5
#   sarvam    → AI_MODEL sarvam-m
AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=

# Partner API key seeded outside production so the /developers demo works.
PARTNER_DEV_API_KEY=sk_dev_groww_since_demo_key
